<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- AppHost's fluent resource-builder model leaves locals unassigned by design; keep
         warnings-as-errors off here only, without weakening it repo-wide. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <UserSecretsId>wisewizard-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WiseWizard.Host\WiseWizard.Host.csproj" />
  </ItemGroup>

</Project>
